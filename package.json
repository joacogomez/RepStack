{
    "name": "repstack",
    "version": "1.0.0",
    "private": true,
    "scripts": {
      "dev:client": "cd client && npm run dev",
      "dev:server": "cd server && venv/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\" --names \"⚛️,🐍\" --prefix_colors \"cyan,green\"",
      "install:client": "cd client && npm install",
      "install:server": "cd server && python3 -m venv venv && venv/bin/pip install -r requirements.txt",
      "install:all": "npm run install:client && npm run install:server && npm install"
    },
    "devDependencies": {
      "concurrently": "^9.2.1"
    }
  }